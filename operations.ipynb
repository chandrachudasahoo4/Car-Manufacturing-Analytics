   "source": [
    "# VIN Validation (Must be 17 characters)\n",
    "\n",
    "production[\"VIN_Status\"] = production[\"VIN\"].apply(\n",
    "    lambda x: \"Valid\" if len(str(x)) == 17 else \"Invalid\"\n",
    ")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 316,
   "id": "097aa5ff",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Mask VIN for secure export\n",
    "# Example:\n",
    "# MA1AB100000000001\n",
    "# becomes\n",
    "# MA1***********001\n",
    "\n",
    "production[\"Masked_VIN\"] = production[\"VIN\"].apply(\n",
    "    lambda x: x[:5] + \"*\" * (len(x) - 8) + x[-3:]\n",
    "    if len(str(x)) == 17\n",
    "    else \"INVALID VIN\"\n",
    ")"
   ]
