   "outputs": [],
   "source": [
    "# Define acceptable operating ranges\n",
    "\n",
    "TORQUE_MIN = 20\n",
    "TORQUE_MAX = 80\n",
    "\n",
    "TEMPERATURE_MIN = 15\n",
    "TEMPERATURE_MAX = 100\n",
    "\n",
    "PRESSURE_MIN = 1\n",
    "PRESSURE_MAX = 10"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 402,
   "id": "3e1b0133",
   "metadata": {},
   "outputs": [],
   "source": [
    "production[\"Anomaly_Status\"] = np.where(\n",
    "\n",
    "    (\n",
    "        (production[\"Torque\"] < TORQUE_MIN) |\n",
    "        (production[\"Torque\"] > TORQUE_MAX) |\n",
    "\n",
    "        (production[\"Temperature\"] < TEMPERATURE_MIN) |\n",
    "        (production[\"Temperature\"] > TEMPERATURE_MAX) |\n",
    "\n",
    "        (production[\"Pressure\"] < PRESSURE_MIN) |\n",
    "        (production[\"Pressure\"] > PRESSURE_MAX)\n",
    "\n",
    "    ),\n",
    "\n",
    "    \"Out of Spec\",\n",
    "\n",
    "    \"Within Spec\"\n",
    "\n",
    ")"
   ]
  },
